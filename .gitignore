# --- Personal / local Claude Code state (never commit) ---
.claude/settings.local.json
.claude/*.local.json
# Personal project notes (loads after CLAUDE.md; per machine/worktree)
CLAUDE.local.md
# Full output of the guard runner (.claude/guards.sh / .claude/guards.ps1)
.claude/guards.log
# Local, user-created one-line wrappers that the optional verify Stop hook auto-runs (only for projects listed in
# ~/.claude/verify-allowed.txt) — keep them user-authored, never pull them from an untrusted repo.
# The committed guard runners live in .claude/guards.sh and .claude/guards.ps1 (NOT ignored: cloud sessions and CI need them).
.claude/checks.cmd
.claude/checks.sh

# --- Secrets & environment (defense-in-depth; also blocked from agent reads) ---
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.pfx
*.p12
.git-credentials
.pgpass
.my.cnf
secrets/
*.tfstate
*.tfstate.backup
*.tfvars

# --- Build / dependency output ---
node_modules/
vendor/
dist/
build/
target/
.venv/
venv/
__pycache__/
coverage/
.next/
.nuxt/
.terraform/
