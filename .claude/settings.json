{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "useAutoModeDuringPlan": false,
  "permissions": {
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(//**/.env)",
      "Read(//**/.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.ppk)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.*)",
      "Read(**/*_rsa)",
      "Read(**/*_ed25519)",
      "Read(**/*_ecdsa)",
      "Read(**/*_dsa)",
      "Read(**/.ssh/**)",
      "Read(**/.git/**)",
      "Read(**/.git-credentials)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.pgpass)",
      "Read(**/.my.cnf)",
      "Read(**/.aws/**)",
      "Read(**/.azure/**)",
      "Read(**/.config/gcloud/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.kube/**)",
      "Read(**/.docker/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.pgpass)",
      "Read(~/.my.cnf)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/gha-creds-*.json)",
      "Read(**/*service-account*.json)",
      "Read(**/secrets/**)",
      "Read(**/credentials)",
      "Read(**/credentials.*)",
      "Read(**/*.credentials)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)",
      "Read(**/*.tfvars)",
      "Read(**/*.auto.tfvars)",
      "Read(**/node_modules/**)",
      "Read(**/vendor/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/target/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/.next/**)",
      "Read(**/.nuxt/**)",
      "Read(**/obj/**)",
      "Read(**/coverage/**)",
      "Read(**/.terraform/**)",
      "Read(**/*.generated.*)",
      "Bash(curl:*)",
      "Bash(curl.exe:*)",
      "Bash(wget:*)",
      "Bash(wget.exe:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(iwr:*)",
      "Bash(Invoke-RestMethod:*)",
      "Bash(irm:*)",
      "Bash(bitsadmin:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(telnet:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(ftp:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(iwr:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "PowerShell(irm:*)",
      "PowerShell(Start-BitsTransfer:*)",
      "PowerShell(bitsadmin:*)",
      "PowerShell(curl:*)",
      "PowerShell(curl.exe:*)",
      "PowerShell(wget:*)",
      "PowerShell(wget.exe:*)",
      "PowerShell(nc:*)",
      "PowerShell(ncat:*)",
      "PowerShell(telnet:*)",
      "PowerShell(scp:*)",
      "PowerShell(sftp:*)",
      "PowerShell(ftp:*)",
      "PowerShell(rm -rf:*)",
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(Remove-Item -Force -Recurse:*)",
      "PowerShell(Remove-Item * -Recurse -Force)",
      "PowerShell(Remove-Item * -Force -Recurse)",
      "PowerShell(sudo:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -fdx:*)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(rsync:*)",
      "Bash(gh gist:*)",
      "Bash(gh repo create:*)",
      "Bash(gh release create:*)",
      "Bash(gh release upload:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(npm publish:*)",
      "Bash(docker push:*)",
      "PowerShell(ssh:*)",
      "PowerShell(rsync:*)",
      "PowerShell(gh gist:*)",
      "PowerShell(gh repo create:*)",
      "PowerShell(gh release create:*)",
      "PowerShell(gh release upload:*)",
      "PowerShell(gh release edit:*)",
      "PowerShell(gh release delete:*)",
      "PowerShell(npm publish:*)",
      "PowerShell(docker push:*)"
    ]
  }
}
